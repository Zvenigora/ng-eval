{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "target": "es2016",
    "types": ["jest", "node"],
    "moduleResolution": "bundler"
  },
  "files": ["src/test-setup.ts"],
  "include": [
    "jest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "reactive/**/*.test.ts",
    "reactive/**/*.spec.ts",
    "reactive/**/*.d.ts",
    "signals/**/*.test.ts",
    "signals/**/*.spec.ts",
    "signals/**/*.d.ts"
  ]
}
