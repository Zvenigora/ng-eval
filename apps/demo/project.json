{
  "name": "demo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/demo/src",
  "prefix": "demo",
  "projectType": "application",
  "tags": ["scope:demo"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/demo",
        "browser": "apps/demo/src/main.ts",
        "index": "apps/demo/src/index.html",
        "tsConfig": "apps/demo/tsconfig.app.json",
        "baseHref": "/ng-eval/",
        "assets": [
          { "glob": "**/*.example.ts", "input": "apps/demo/src/app", "output": "source" },
          { "glob": "package.json", "input": "modules/eval-core", "output": "packages/eval-core" },
          { "glob": "package.json", "input": "modules/eval-signals", "output": "packages/eval-signals" },
          { "glob": "package.json", "input": "modules/eval-forms", "output": "packages/eval-forms" }
        ],
        "styles": ["apps/demo/src/styles.css"]
      },
      "configurations": {
        "production": {
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "demo:build:production"
        },
        "development": {
          "buildTarget": "demo:build:development"
        }
      }
    }
  }
}
